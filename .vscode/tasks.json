{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "g++: prepare build directory",
            "type": "process",
            "command": "mkdir",
            "args": ["-p", "${workspaceFolder}/build"],
            "problemMatcher": []
        },
        {
            "label": "g++: build 第06课",
            "type": "process",
            "command": "/usr/bin/g++",
            "args": [
                "-std=c++17",
                "-Wall", "-Wextra", "-Wpedantic",
                "-g", "-O0",
                "${workspaceFolder}/exercises/06_imu_sequence/main.cpp",
                "-o", "${workspaceFolder}/build/imu_sequence_direct"
            ],
            "dependsOn": "g++: prepare build directory",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "CMake: configure Debug",
            "type": "process",
            "command": "cmake",
            "args": [
                "-S", "${workspaceFolder}",
                "-B", "${workspaceFolder}/build",
                "-G", "Ninja",
                "-DCMAKE_BUILD_TYPE=Debug"
            ],
            "problemMatcher": []
        },
        {
            "label": "CMake: build 第03课",
            "type": "process",
            "command": "cmake",
            "args": [
                "--build", "${workspaceFolder}/build",
                "--target", "imu_buffer_demo"
            ],
            "dependsOn": "CMake: configure Debug",
            "dependsOrder": "sequence",
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "CMake: build 第04课",
            "type": "process",
            "command": "cmake",
            "args": [
                "--build", "${workspaceFolder}/build",
                "--target", "sensor_ownership_demo"
            ],
            "dependsOn": "CMake: configure Debug",
            "dependsOrder": "sequence",
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "CMake: build 第05课",
            "type": "process",
            "command": "cmake",
            "args": [
                "--build", "${workspaceFolder}/build",
                "--target", "measurement_packet_demo"
            ],
            "dependsOn": "CMake: configure Debug",
            "dependsOrder": "sequence",
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "problemMatcher": ["$gcc"]
        }
    ]
}
